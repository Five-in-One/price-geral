# Variáveis do docker-compose.yml (copie para .env e ajuste).

# Segredo HS256 que o price-auth usa para assinar o JWT e que price-back e
# price-user usam para conferir a assinatura. Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta do gateway (Nginx) na máquina.
GATEWAY_PORT=80

# Conta que o worker do bot usa para obter o JWT no price-auth (papel admin).
BOT_USERNAME=admin
BOT_PASSWORD=TrocarSenha123!

# Chave do Google Gemini usada pelo bot para interpretar as páginas coletadas.
GEMINI_API_KEY=sua_chave_da_api_aqui
